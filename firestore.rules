rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true
      && request.auth.token.email.lower() in ['mvrahiotes@gmail.com']; }
    function member(cid) { return signedIn()
      && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }
    match /couples/{cid} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        ( resource.data.members.size() < 2
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members ) );
      match /data/{doc} {
        allow read, write: if member(cid);
      }
    }
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() < 5000;
      allow read: if isAdmin();
    }
  }
}
